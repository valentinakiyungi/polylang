# Copy to .env and adjust. Every value is optional.

# --- Storage ---------------------------------------------------------------
POLYLANG_DATA_DIR=./storage
POLYLANG_PERSIST=true

# --- Embeddings ------------------------------------------------------------
# sentence-transformers = real multilingual model (cross-lingual search & cache)
# hashing               = offline, dependency-free fallback (same-language only)
POLYLANG_EMBEDDING_BACKEND=sentence-transformers
POLYLANG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# POLYLANG_EMBEDDING_DEVICE=cpu

# --- Chunking & retrieval --------------------------------------------------
POLYLANG_CHUNK_SIZE=800
POLYLANG_CHUNK_OVERLAP=120
POLYLANG_TOP_K=4
# rrf (reciprocal rank fusion) or weighted (min-max normalised alpha blend)
POLYLANG_FUSION=rrf
POLYLANG_DENSE_WEIGHT=0.6

# --- Semantic cache --------------------------------------------------------
POLYLANG_CACHE_ENABLED=true
POLYLANG_CACHE_THRESHOLD=0.88
POLYLANG_CACHE_MAX_ENTRIES=5000
POLYLANG_CACHE_TTL_SECONDS=86400
POLYLANG_CACHE_CROSS_LINGUAL=true

# --- Answer generation -----------------------------------------------------
# extractive (no LLM) | openai | anthropic | ollama
POLYLANG_LLM_PROVIDER=extractive
# POLYLANG_LLM_MODEL=gpt-4o-mini
# POLYLANG_LLM_BASE_URL=            # e.g. http://localhost:11434 for Ollama, or any OpenAI-compatible URL
# POLYLANG_LLM_API_KEY=             # falls back to OPENAI_API_KEY / ANTHROPIC_API_KEY
POLYLANG_LLM_TEMPERATURE=0.2
POLYLANG_LLM_MAX_TOKENS=600

# --- API -------------------------------------------------------------------
# When set, every endpoint except /health and the web UI requires header X-API-Key
# POLYLANG_API_KEY=change-me
POLYLANG_MAX_UPLOAD_MB=25
POLYLANG_CORS_ORIGINS=*
