# Copy to .env and adjust. Every value is optional.

# --- Storage ---------------------------------------------------------------
RAG_DATA_DIR=./storage
RAG_PERSIST=true

# --- Embeddings ------------------------------------------------------------
# sentence-transformers = real multilingual model (cross-lingual search & cache)
# hashing               = offline, dependency-free fallback (same-language only)
RAG_EMBEDDING_BACKEND=sentence-transformers
RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# RAG_EMBEDDING_DEVICE=cpu

# --- Chunking & retrieval --------------------------------------------------
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
# rrf (reciprocal rank fusion) or weighted (min-max normalised alpha blend)
RAG_FUSION=rrf
RAG_DENSE_WEIGHT=0.6

# --- Semantic cache --------------------------------------------------------
RAG_CACHE_ENABLED=true
RAG_CACHE_THRESHOLD=0.88
RAG_CACHE_MAX_ENTRIES=5000
RAG_CACHE_TTL_SECONDS=86400
RAG_CACHE_CROSS_LINGUAL=true

# --- Answer generation -----------------------------------------------------
# extractive (no LLM) | openai | anthropic | ollama
RAG_LLM_PROVIDER=extractive
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_LLM_BASE_URL=            # e.g. http://localhost:11434 for Ollama, or any OpenAI-compatible URL
# RAG_LLM_API_KEY=             # falls back to OPENAI_API_KEY / ANTHROPIC_API_KEY
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_TOKENS=600

# --- API -------------------------------------------------------------------
# When set, every endpoint except /health and the web UI requires header X-API-Key
# RAG_API_KEY=change-me
RAG_MAX_UPLOAD_MB=25
RAG_CORS_ORIGINS=*
